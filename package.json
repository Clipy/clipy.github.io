    "build": "eleventy"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "7.0.0",
    "@lingual/i18n-check": "0.9.5",
    "swiper": "14.3.0"
  }
}
